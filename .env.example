# ==============================================================
# CampusFlow - Campus Event Planning Assistant Environment Config
# ==============================================================

PROJECT_NAME=CampusFlow - Campus Event Planning Assistant
VERSION=1.0.0
ENVIRONMENT=development

# Database Configuration (Defaults to local SQLite, can be swapped for PostgreSQL with pgvector)
DATABASE_URL=sqlite:///./data/database/campusflow.db

# AI / LLM Configuration (Optional - CampusFlow operates with deterministic grounded RAG fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Demo Mode (Pre-seeds clearly labeled DEMO DOCUMENT test policies)
DEMO_MODE=true
